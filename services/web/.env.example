# Network configuration. Copy this file to .env and edit the values.

# testnet or mainnet
PUBLIC_NEAR_NETWORK=testnet

# JSON-RPC endpoint used for reads. Writes are signed by the wallet.
PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org

# Factory contract that deploys rbac-nft children and maintains the registry.
PUBLIC_FACTORY_CONTRACT_ID=rbac-factory.testnet

# Optional explorer base URL used for transaction links.
PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io

# Optional SHA-256 of the rbac-nft wasm stored by the immutable factory. When set, the web app
# refuses to deploy if the factory reports a different child code hash.
PUBLIC_EXPECTED_CHILD_CODE_HASH=
