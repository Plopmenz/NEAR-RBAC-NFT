# Network configuration. Copy this file to .env and edit the values.

# testnet or mainnet
PUBLIC_NEAR_NETWORK=testnet

# JSON-RPC endpoint used for reads. Writes are signed by the wallet.
PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# Factory contract that deploys payrole-nft children and maintains the registry.
PUBLIC_FACTORY_CONTRACT_ID=payrole-factory.testnet

# Optional explorer base URL used for transaction links.
PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io

# Optional SHA-256 of the payrole-nft wasm stored by the immutable factory. When set, the web app
# refuses to deploy if the factory reports a different child code hash.
PUBLIC_EXPECTED_CHILD_CODE_HASH=c8d3c4475f819cab26de4d2c803fb1ad534a1e11e45ccb41aa11465d92e7b781

# Optional absolute public URL, e.g. https://near-payrole.vercel.app. Used for the canonical link and
# Open Graph/Twitter preview tags and as the default OIDC redirect origin. When unset those tags are
# omitted and the OIDC callback uses the current browser origin.
PUBLIC_SITE_URL=https://near-payrole.vercel.app

# Demo NEP-141 salary token created by scripts/deploy-salary-token.sh. When set, the deploy form
# pre-fills it and owned contracts using it get a free "Fund 100" button. Leave empty to hide the
# demo funding controls.
PUBLIC_SALARY_TOKEN_ID=payrole-mock-ft.testnet
PUBLIC_SALARY_TOKEN_DECIMALS=6
PUBLIC_SALARY_TOKEN_SYMBOL=MOCK
PUBLIC_DEMO_FUND_AMOUNT=100

# OpenID Connect provider used by the access tab. The app is a public PKCE client, so no secret is
# stored. PUBLIC_OIDC_REDIRECT_URI defaults to ${PUBLIC_SITE_URL}/oidc/callback when site URL is set,
# otherwise to ${window.location.origin}/oidc/callback. Register that exact URI with the provider.
# The provider must allow this site's origin in allowed_origins for CORS.
PUBLIC_OIDC_ISSUER=https://payrole-oidc.plopmenz.openmesh.cloud
PUBLIC_OIDC_CLIENT_ID=payrole-web
PUBLIC_OIDC_SCOPES=openid profile roles
PUBLIC_OIDC_REDIRECT_URI=
