---
import "@near-wallet-selector/modal-ui/styles.css";
import "../styles/global.css";
import { DEFAULT_PAYOUT_INTERVAL_NS } from "../lib/config";

const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? "").trim().replace(/\/+$/, "");
const description =
  "PayRole: on-chain roles and payroll for NEAR DAOs. Deploy non-transferable role NFTs with NEP-141 salary streaming in one transaction.";
const socialImage = siteUrl ? `${siteUrl}/og.png` : "";
const defaultIntervalDays = (DEFAULT_PAYOUT_INTERVAL_NS / 86_400_000_000_000n).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>PayRole — on-chain roles and payroll for NEAR DAOs</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="PayRole — on-chain roles and payroll for NEAR DAOs" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content={siteUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content="PayRole — on-chain roles and payroll for NEAR DAOs" />
    <meta name="twitter:description" content={description} />
    {
      siteUrl && (
        <>
          <link rel="canonical" href={siteUrl} />
          <meta property="og:url" content={siteUrl} />
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:alt" content="PayRole key badge" />
          <meta name="twitter:image" content={socialImage} />
        </>
      )
    }
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" focusable="false">
            <path
              d="M16 2.5 27 7v8.5c0 6.5-4.4 11.6-11 14-6.6-2.4-11-7.5-11-14V7z"
              fill="currentColor"
              opacity="0.16"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
            <circle cx="13" cy="13" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path
              d="M15.4 15.4 21 21m-2.2-.2 1.7-1.7m-4.1 0 1.7-1.7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span>Pay<span class="brand-accent">Role</span></span>
      </a>
      <div class="topbar-right">
        <span class="network-badge" id="network-badge">testnet</span>
        <span class="wallet-account" id="wallet-account">Not connected</span>
        <button class="btn btn-small" id="wallet-button" type="button">Connect wallet</button>
        <button class="btn btn-small ghost" id="wallet-disconnect" type="button" hidden>
          Disconnect
        </button>
      </div>
    </header>

    <main class="shell">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Roles as non-transferable NFTs</p>
          <h1>On-chain roles and payroll for NEAR DAOs.</h1>
          <p class="lede">
            Deploy a PayRole contract in one transaction, grant roles as non-transferable NEP-245
            NFTs, and let members claim NEP-141 salary per role. No indexer: discovery is read
            directly from the factory registry and each contract.
          </p>
        </div>
        <div class="hero-art">
          <svg viewBox="0 0 420 280" role="img" aria-labelledby="hero-diagram-title">
            <title id="hero-diagram-title">
              An immutable factory deploys a role NFT contract. Role badges gate access and unlock
              NEP-141 salary claims.
            </title>
            <defs>
              <linearGradient id="flow-accent" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7cf5c8"></stop>
                <stop offset="1" stop-color="#7aa9ff"></stop>
              </linearGradient>
            </defs>
            <g class="flow-lines" stroke="url(#flow-accent)" stroke-width="2" fill="none">
              <path d="M210 78v26" marker-end="url(#flow-arrow)"></path>
              <path d="M210 168v26"></path>
              <path d="M210 194H120v20" marker-end="url(#flow-arrow)"></path>
              <path d="M210 194h90v20" marker-end="url(#flow-arrow)"></path>
            </g>
            <defs>
              <marker
                id="flow-arrow"
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse">
                <path d="M0 0 10 5 0 10z" fill="#7cf5c8"></path>
              </marker>
            </defs>
            <g class="flow-node">
              <rect x="30" y="16" width="360" height="62" rx="14"></rect>
              <text x="52" y="43" class="flow-title">Immutable factory</text>
              <text x="52" y="62" class="flow-sub">wasm pinning · on-chain registry</text>
            </g>
            <g class="flow-node accent">
              <rect x="30" y="104" width="360" height="64" rx="14"></rect>
              <text x="52" y="132" class="flow-title">Role NFT + payroll contract</text>
              <text x="52" y="151" class="flow-sub">per-role owner · salary per interval</text>
            </g>
            <g class="flow-node">
              <rect x="30" y="216" width="170" height="56" rx="12"></rect>
              <text x="50" y="241" class="flow-title">Role badge</text>
              <text x="50" y="259" class="flow-sub">NEP-245 · has_role()</text>
            </g>
            <g class="flow-node">
              <rect x="220" y="216" width="170" height="56" rx="12"></rect>
              <text x="240" y="241" class="flow-title">Salary claim</text>
              <text x="240" y="259" class="flow-sub">NEP-141 · every interval</text>
            </g>
          </svg>
        </div>
      </section>

      <div class="warning" id="config-warning" hidden></div>
      <div class="notice" id="global-notice" hidden role="status"></div>

      <nav class="tabs" aria-label="Views" role="tablist">
        <button class="tab" data-tab="deploy" type="button" role="tab" aria-selected="true">
          1. Deploy
        </button>
        <button class="tab" data-tab="contracts" type="button" role="tab" aria-selected="false">
          2. Owned contracts
        </button>
        <button class="tab" data-tab="roles" type="button" role="tab" aria-selected="false">
          3. My roles
        </button>
        <button class="tab" data-tab="access" type="button" role="tab" aria-selected="false">
          4. OIDC access
        </button>
      </nav>

      <section class="panel" data-panel="deploy" role="tabpanel">
        <div class="panel-heading">
          <div>
            <h2>Deploy a PayRole contract</h2>
            <p class="muted">
              The factory creates <code>{"{name}.{factory}"}</code>, deploys the wasm, and initializes
              the contract with the owner you choose. The owner can be a DAO, Trezu, or any NEAR
              account.
            </p>
          </div>
          <div id="factory-summary" class="stat-box">
            <span class="stat-label">Factory</span>
            <span class="stat-value" id="factory-id">not configured</span>
          </div>
        </div>

        <div class="two-column">
          <form class="card form" id="deploy-form" novalidate>
            <h3>Contract settings</h3>

            <label class="field">
              <span>Subaccount name</span>
              <input
                id="deploy-name"
                name="name"
                placeholder="acme"
                autocomplete="off"
                required
              />
              <small>Lowercase letters, digits, '-' and '_'. The factory suffix is added.</small>
            </label>

            <label class="field">
              <span>Contract owner</span>
              <input
                id="deploy-owner"
                name="owner"
                placeholder="dao.testnet"
                autocomplete="off"
                required
              />
              <small>
                Use your DAO/Trezu account. The connected wallet pays for deployment and must hold
                enough NEAR.
              </small>
            </label>

            <label class="field">
              <span>Salary token (NEP-141)</span>
              <input
                id="deploy-token"
                name="token"
                placeholder="usdc.testnet"
                autocomplete="off"
                required
              />
              <small>The token contract used by <code>ft_transfer</code> for salary payouts.</small>
            </label>

            <div class="field">
              <span>Payout interval</span>
              <div class="inline-fields">
                <input
                  id="deploy-interval-value"
                  name="intervalValue"
                  type="number"
                  min="1"
                  step="1"
                  value={defaultIntervalDays}
                  required
                />
                <select id="deploy-interval-unit" name="intervalUnit">
                  <option value="seconds">seconds</option>
                  <option value="minutes">minutes</option>
                  <option value="hours">hours</option>
                  <option value="days" selected>days</option>
                  <option value="weeks">weeks</option>
                </select>
              </div>
              <small>Salary accrues in full intervals of this length.</small>
            </div>

            <label class="field">
              <span>Attached deposit (NEAR)</span>
              <input
                id="deploy-deposit"
                name="deposit"
                inputmode="decimal"
                placeholder="6"
                required
              />
              <small id="deploy-deposit-hint">
                The factory reports the minimum deposit after loading.
              </small>
            </label>

            <p class="preview" id="deploy-preview">Enter a name to see the child account id.</p>
            <div class="form-actions">
              <button class="btn" id="deploy-submit" type="submit">Deploy contract</button>
            </div>
            <p class="status" id="deploy-status" role="status"></p>
          </form>

          <aside class="card aside-card">
            <h3>What you get</h3>
            <ul class="check-list">
              <li>Non-transferable NEP-245 role NFTs.</li>
              <li>Per-role NEP-141 salary, paid per full interval.</li>
              <li>Role-owned mint and burn administration.</li>
              <li>On-chain <code>has_role</code> checks for other contracts.</li>
              <li>Optional OIDC SSO backed by live on-chain roles.</li>
            </ul>
            <h3>Deployment cost</h3>
            <p class="muted">
              Each child stores its own copy of the payrole-nft wasm. The required deposit is roughly
              4.1 NEAR depending on the wasm size and network storage price. The factory forwards
              the deposit to the child; it is not a fee.
            </p>
            <p class="muted" id="factory-code-note"></p>
          </aside>
        </div>
      </section>

      <section class="panel" data-panel="contracts" role="tabpanel" hidden>
        <div class="panel-heading">
          <div>
            <h2>Contracts you own</h2>
            <p class="muted">
              Scans the factory registry and verifies each child's live <code>owner_id()</code>.
              Anyone can deploy a contract with your account as owner, so favorite the real ones.
            </p>
          </div>
        </div>

        <form class="search-row" id="owned-form">
          <input
            id="owned-address"
            name="address"
            placeholder="dao.testnet"
            autocomplete="off"
            aria-label="Owner account to scan"
          />
          <button class="btn" type="submit">Scan</button>
          <button class="btn ghost" id="owned-use-wallet" type="button">Use connected wallet</button>
        </form>
        <label class="checkbox-row">
          <input type="checkbox" id="favorites-only" />
          <span>Show favorites only</span>
          <span class="muted" id="favorites-count"></span>
        </label>

        <p class="status" id="owned-status" role="status"></p>
        <div id="owned-summary"></div>
        <div class="card-list" id="owned-list"></div>
      </section>

      <section class="panel" data-panel="roles" role="tabpanel" hidden>
        <div class="panel-heading">
          <div>
            <h2>Roles you hold</h2>
            <p class="muted">
              Shows each role membership, the time until the next payout, the claimable amount, and
              a claim button. Enter any address or use the connected wallet.
            </p>
          </div>
        </div>

        <form class="search-row" id="roles-form">
          <input
            id="roles-address"
            name="address"
            placeholder="alice.testnet"
            autocomplete="off"
            aria-label="Account whose roles to show"
          />
          <button class="btn" type="submit">Scan</button>
          <button class="btn ghost" id="roles-use-wallet" type="button">Use connected wallet</button>
          <button class="btn ghost" id="roles-refresh" type="button">Refresh</button>
        </form>

        <p class="status" id="roles-status" role="status"></p>
        <div id="roles-summary"></div>
        <div class="card-list" id="roles-list"></div>
      </section>

      <section class="panel" data-panel="access" role="tabpanel" hidden>
        <div class="panel-heading">
          <div>
            <h2>OIDC access</h2>
            <p class="muted">
              Sign in with your NEAR wallet through the OpenID Connect provider, then see which
              sample access labels your live role NFTs grant. The provider proves the account;
              roles are read directly from every registry contract.
            </p>
          </div>
          <div class="stat-box">
            <span class="stat-label">Flow</span>
            <span class="stat-value">PKCE + NEP-413</span>
          </div>
        </div>

        <div class="card access-card">
          <div id="oidc-session"></div>
          <div class="form-actions">
            <button class="btn" id="oidc-login" type="button">Sign in with OIDC</button>
            <button class="btn ghost" id="oidc-logout" type="button" hidden>Sign out</button>
            <button class="btn ghost" id="access-refresh" type="button">Refresh roles</button>
          </div>
          <p class="status" id="access-status" role="status"></p>
        </div>

        <p class="muted small access-hint">
          Contract owners can map roles to labels in <strong>Owned contracts → Contract
          administration → OIDC access labels</strong>. The mapping is stored locally in this
          browser; the role check itself is always live on-chain. If no labels are configured,
          the page uses role names as sample access labels.
        </p>

        <div id="access-summary"></div>
        <div class="card-list" id="access-list"></div>
      </section>
    </main>

    <footer class="footer">
      <span>PayRole · hackathon project, not audited</span>
      <span>
        <a href="https://github.com/Plopmenz/NEAR-RBAC-NFT" rel="noreferrer">Source</a>
      </span>
    </footer>

    <noscript>
      <p class="warning">This app needs JavaScript to query NEAR and sign wallet transactions.</p>
    </noscript>

    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
